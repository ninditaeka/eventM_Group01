// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           Int @id @default(autoincrement())
  first_name                   String @db.VarChar(50)
  last_name                    String @db.VarChar(50)
  email                        String @db.VarChar(50) @unique
  password                     String @db.VarChar(100)
  role                         String @db.VarChar(20)
  events                       Event[]
  created_at                   DateTime @default(now())
  referral_codes               Referral_code? @relation("Use ReferralCode")
  referral_code_use            String @db.VarChar(50) @default("")
  point_balances               Point_balance[]
  discount_coupons             Discount_coupon[]
  payments                     Payment[]
  checkouts                    Checkout[]
  review_ratings               Review_Rating[]

  @@map("users")
}

model Event {
id                              Int @id @default(autoincrement())
user                            User @relation(fields: [created_by],references: [id])
created_by                      Int
title                           String? @db.VarChar(200)
description                     String?
image                           String? 
location                        String? @db.VarChar (50)
date                            DateTime?
event_type                      String? @db.VarChar(50)
price                           Int?
total_transaction_discount      Int
total_seat                      Int
category                        String? @db.VarChar (50)
created_at                      DateTime @default(now())
updated_at                      DateTime @updatedAt
deleted                         Boolean @default(false)
payments                        Payment[]
checkouts                       Checkout[]
review_ratings                  Review_Rating[]





@@map ("events")

}

model Referral_code {
id                              Int @id @default(autoincrement())
referral_code                   String? @db.VarChar(50) @unique
created_at                      DateTime @default(now())
userId                          Int @unique
user                            User @relation("Use ReferralCode",fields: [userId], references: [id])

@@map ("referral_codes")
}


model Point_balance {
id                              Int           @id @default(autoincrement())
expired_date                    DateTime?
point                           Int?
action                          String?        @db.VarChar(50)
created_at                      DateTime?      @default(now())
updated_at                      DateTime?      @updatedAt
userId                          Int
user                            User           @relation(fields: [userId], references: [id])



  @@map("point_balances")
}


model Discount_coupon {
id                              Int           @id @default(autoincrement())
discount                        String?       @db.VarChar(50)
created_at                      DateTime      @default(now())
updated_at                      DateTime      @updatedAt
expired_date                    DateTime?
action                          String?       @db.VarChar(50)
userId                          Int
user                            User          @relation(fields: [userId], references: [id])

  @@map ("discount_coupons")
}








model Checkout {
  id                              Int           @id @default  (autoincrement())
  created_at                      DateTime?      @default(now())
  payments                        Payment[]
  point_balance_use               Int?
  discount_nominal_use            Int?
  final_price                     Int?
  price                           Int
  userId                          Int
  user                            User          @relation(fields: [userId], references: [id]) 
  eventId                         Int
  event                           Event         @relation(fields: [eventId], references: [id])      
  quantity                        Int?   
    


  @@map ("checkouts")
}


model Payment {
  id                              Int           @id @default(autoincrement())
  created_at                      DateTime      @default(now())
  eventId                         Int
  event                           Event         @relation(fields: [eventId], references: [id])
  userId                          Int
  user                            User          @relation(fields: [userId], references: [id])
  checkoutId                      Int
  checkout                        Checkout      @relation(fields: [checkoutId], references: [id])
  price_paid                      Int
  is_paid                         Boolean    @default(false)

  @@index([userId, eventId, checkoutId])
  @@unique([eventId, userId, checkoutId]) 
  @@map ("payments")


  
}



model Review_Rating {
id                              Int           @id @default(autoincrement())
eventId                         Int
event                           Event         @relation(fields: [eventId], references: [id])
userId                          Int
user                            User          @relation(fields: [userId], references: [id])
rating                          Int
comment                         String 
created_at                      DateTime      @default(now())  

  @@map ("review_ratings")
}